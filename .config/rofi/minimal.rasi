/* ─────────── Rofi · tema minimal (Dark Minimal v3) ─────────── */

* {
    bg:        #0a0a0bd9;
    bg1:       #111113;
    bg2:       #18181b;
    bg3:       #232327;
    fg:        #d6d3cd;
    muted:     #6e6c69;
    accent:    #d9d4c7;
    alert:     #a15c5c;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    location:         center;
    anchor:           center;
    width:            520px;
    background-color: @bg;
    border:           1px;
    border-color:     @bg3;
    border-radius:    12px;
    padding:          0;
}

mainbox {
    spacing:  0;
    padding:  0;
    children: [ "inputbar", "message", "listview" ];
}

/* ── Barra de búsqueda: línea fina inferior ── */
inputbar {
    padding:      14px 16px 12px 16px;
    spacing:      10px;
    border:       0 0 1px 0;
    border-color: @bg3;
    children:     [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "buscar";
    placeholder-color: @muted;
    cursor:            text;
}

message {
    padding:      8px 16px;
    border:       0 0 1px 0;
    border-color: @bg3;
}

textbox {
    text-color: @muted;
}

/* ── Lista ── */
listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      2px;
    padding:      8px;
    cycle:        true;
}

element {
    padding:       8px 10px;
    spacing:       12px;
    border:        0 0 0 1px;
    border-color:  transparent;
    border-radius: 6px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @bg2;
    text-color:       @accent;
    border-color:     @accent;
}

element normal.urgent,
element alternate.urgent {
    text-color: @alert;
}

element selected.urgent {
    background-color: @bg2;
    text-color:       @alert;
    border-color:     @alert;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element-icon {
    size:       22px;
    text-color: inherit;
    cursor:     inherit;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    cursor:         inherit;
}
