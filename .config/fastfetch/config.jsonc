// ─────────── fastfetch · Dark Minimal ───────────
// Foto a la izquierda (protocolo de imágenes de kitty), datos a la derecha.
// Cambiar la foto: reemplaza ~/.config/fastfetch/logo.png (PNG).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo.png",
    "width": 36,
    "height": 18,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;110;108;105",
      "title": "38;2;217;212;199",
      "output": "38;2;214;211;205",
      "separator": "38;2;110;108;105"
    },
    "key": {
      "width": 14
    },
    "percent": {
      "type": [
        "num"
      ]
    },
    "bar": {}
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "38;2;217;212;199",
        "at": "38;2;110;108;105",
        "host": "38;2;217;212;199"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;110;108;105"
    },
    {
      "type": "os",
      "key": "  sistema"
    },
    {
      "type": "kernel",
      "key": "󰌽  kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐  encendido"
    },
    {
      "type": "packages",
      "key": "󰏗  paquetes"
    },
    {
      "type": "shell",
      "key": "󰆍  shell"
    },
    {
      "type": "wm",
      "key": "󱂬  wm"
    },
    {
      "type": "terminal",
      "key": "󰞷  terminal"
    },
    {
      "type": "terminalfont",
      "key": "󰛖  fuente"
    },
    {
      "type": "cpu",
      "key": "󰻠  cpu",
      "showPeCoreCount": false,
      "temp": true
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu"
    },
    {
      "type": "memory",
      "key": "󰍛  memoria"
    },
    {
      "type": "swap",
      "key": "󰓡  swap"
    },
    {
      "type": "disk",
      "key": "󰋊  disco",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "󰍹  pantalla",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "localip",
      "key": "󰲐  ip local",
      "compact": true
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
